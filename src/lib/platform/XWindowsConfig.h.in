#pragma once

/* Define to 1 if the corresponding X11 extension header is available. */
#cmakedefine01 HAVE_X11_EXTENSIONS_XRANDR_H
#cmakedefine01 HAVE_X11_EXTENSIONS_DPMS_H
#cmakedefine01 HAVE_X11_EXTENSIONS_XINERAMA_H
#cmakedefine01 HAVE_X11_EXTENSIONS_XTEST_H

/* Defined when the XInput2 extension is available. */
#cmakedefine HAVE_XI2

/* Define to 1 when the XKB extension is available. */
#cmakedefine01 HAVE_XKB_EXTENSION
